# Copy to .env and fill in. .env is gitignored; never commit real values.

# ---------------------------------------------------------------------------
# Supabase — Phase 1. All present already.
# ---------------------------------------------------------------------------
# Postgres connection strings. DIRECT is used by migrations (no pooler, so DDL
# and advisory locks behave); POOLER/TRXN are for runtime connections.
SUPABASE_DIRECT_URL=
SUPABASE_TRXN_URL=
SUPABASE_POOLER_URL=

NEXT_PUBLIC_SUPABASE_URL=
# New-style key names. The publishable key is safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Bypasses RLS entirely. Server-only, never in a NEXT_PUBLIC_ var, never
# imported into a client component. See CLAUDE.md for the exact route list.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Shared secrets — generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
# Presented by pg_cron (via pg_net) when calling /api/cron/*. Also stored in
# Supabase Vault so the cron job can read it back.
CRON_SECRET=
# Presented by the Auto-Receptionist repo when POSTing to /api/v1/demos.
AR_INGEST_SECRET=

# ---------------------------------------------------------------------------
# Google — Phase 2 (Gmail send/receive). Not needed to run Phase 1.
# ---------------------------------------------------------------------------
# OAuth 2.0 Web client, published INTERNAL to the Workspace org.
# Scopes: gmail.send + gmail.readonly. Deliberately NOT gmail.modify, so the
# app is structurally incapable of touching Instantly's warmup mail.
# Do not use External/Testing mode: refresh tokens expire after 7 days there.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Local dev / tests
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
